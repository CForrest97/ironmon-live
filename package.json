{
  "name": "ironmon-live-repository-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation contracts and repository quality tooling for IronMON Live",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "npm run tauri:dev --workspace=@ironmon-live/companion",
    "dev": "scripts/dev.sh",
    "lint:markdown": "markdownlint-cli2",
    "lint:ts": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "tsc --noEmit && npm run check:types --workspaces --if-present",
    "validate:docs": "node scripts/validate-docs.ts",
    "validate:workflows": "node scripts/validate-workflows.ts",
    "test": "node --test test/*.test.ts && npm run test --workspaces --if-present",
    "test:latency": "npm run test:latency --workspace=@ironmon-live/companion",
    "check": "npm run lint:markdown && npm run format:check && npm run lint:ts && npm run check:types && npm run validate:docs && npm run validate:workflows && npm test",
    "check:external": "node scripts/check-external-links.ts",
    "configure:github": "scripts/configure-github.sh",
    "release:tag": "scripts/push-release-tag.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
