{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Minimum capabilities for the IronMON Live companion window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "autostart:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-message",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-watch",
    "notification:default",
    "process:allow-exit",
    "updater:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/.ironmon-live" },
        { "path": "$HOME/.ironmon-live/*" },
        { "path": "$RESOURCE/IronMONLive.lua" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://live.craigforrest.co.uk/**" }]
    }
  ]
}
