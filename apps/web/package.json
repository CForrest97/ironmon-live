{
  "name": "@ironmon-live/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "WRANGLER_LOG_PATH=.wrangler/build.log vite build",
    "check:types": "tsc --noEmit && tsc --noEmit --project visual",
    "dev": "vite",
    "deploy": "npm run build && wrangler deploy",
    "review:visual": "node visual/review.ts",
    "capture:visual": "node visual/capture.ts",
    "test": "vitest run && playwright test"
  },
  "dependencies": {
    "@ironmon-live/contracts": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.1",
    "@cloudflare/workers-types": "5.20260925.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.1",
    "wrangler": "4.140.0"
  }
}
